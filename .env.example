# ==========================================
# PRECEDENT — Institutional Intelligence Platform
# Environment Configuration Template
# ==========================================

# Groq AI Inference Configuration
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Hindsight Memory Engine
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=precedent-institutional-memory

# Database (SQLAlchemy / PostgreSQL or SQLite)
# Production PostgreSQL example: postgresql://user:password@host:5432/precedent
# Persistent Disk SQLite example: sqlite:////var/data/precedent.db
DATABASE_URL=sqlite:///./precedent.db

# Backend Service
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Production CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Frontend Application (Vercel)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_APP_NAME=PRECEDENT

# Security & Multi-Tenancy Defaults
DEFAULT_ORGANIZATION_ID=org_precedent_demo
SECRET_KEY=

# File Storage
UPLOAD_DIR=uploads
