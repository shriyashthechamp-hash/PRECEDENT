# ==========================================
# PRECEDENT — Backend Environment Variables
# ==========================================

# Groq AI Inference
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Hindsight Biomimetic Memory
HINDSIGHT_API_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=precedent-institutional-memory

# Database (PostgreSQL on Render or SQLite)
DATABASE_URL=sqlite:///./precedent.db

# Server Bindings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# Production CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Security
DEFAULT_ORGANIZATION_ID=org_precedent_demo
SECRET_KEY=

# Uploads
UPLOAD_DIR=uploads

